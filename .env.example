# GeekOAuth IdP (do not trail-slash; leave unset rather than empty)
NEXT_PUBLIC_AUTH_URL=https://auth.geekatyourspot.com

# This app origin (must match an allowed redirect URI on the OAuth client).
# Local:
NEXT_PUBLIC_APP_URL=http://localhost:3004
# Vercel production (set in Project → Settings → Environment Variables):
# NEXT_PUBLIC_APP_URL=https://content-creator-v2-phi.vercel.app
# If unset on Vercel, the app falls back to https://$VERCEL_URL.

# OAuth client id registered in GeekOAuth.
# Redirect URIs must include both local and Vercel callback URLs, e.g.:
#   http://localhost:3004/auth/callback
#   https://content-creator-v2-phi.vercel.app/auth/callback
NEXT_PUBLIC_OAUTH_CLIENT_ID=geek-content-creator-v2

# GeekAPI base — BFF proxy target (app/api/gcc-v2/[...path]) and default hub host.
NEXT_PUBLIC_GEEK_API_URL=https://api.geekatyourspot.com

# Optional override for the realtime hub URL. Defaults to `${NEXT_PUBLIC_GEEK_API_URL}/hubs/gcc-v2-realtime`.
# NEXT_PUBLIC_GCC_V2_HUB_URL=https://api.geekatyourspot.com/hubs/gcc-v2-realtime
